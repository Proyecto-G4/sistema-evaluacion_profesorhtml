            WHERE alumno_consigna_id_asignacion = ?
        `, [id])

        if (respuestasExistentes.length > 0) {
            return res.status(409).json({ mensaje: "Esta pregunta ya fue respondida" })
        }
        const [resultado] = await pool.query(`
            INSERT INTO respuesta (
