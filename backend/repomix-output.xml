            asignacion.id_asignacion
        ])

        await pool.query(`
            UPDATE alumno_consigna
            SET estado = 'respondida'
            WHERE id_asignacion = ?
        `, [id])

        return res.status(201).json({
            mensaje: "Respuesta guardada correctamente",
